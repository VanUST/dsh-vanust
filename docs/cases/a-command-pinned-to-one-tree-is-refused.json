{
  "schemaVersion": 1,
  "id": "a-command-pinned-to-one-tree-is-refused",
  "title": "A command pinned to one tree is refused",
  "requirement": "A case whose runCommand starts with cd /... or carries an absolute path cannot be registered and cannot be saved through case_update; the refusal names the reason and offers the relative-command-plus-cwd route, and a case already recorded that way stays readable (REQ-181).",
  "kind": "regression",
  "status": "verified",
  "source": "agent",
  "automated": true,
  "testPath": "plugins/test-cases/test/run-cwd-pinned.test.mjs",
  "runCommand": "node --test plugins/test-cases/test/run-cwd-pinned.test.mjs",
  "steps": [
    "Try case_record with three pinned commands (POSIX cd, POSIX argument, Windows drive)",
    "Try case_update on a legacy case that already carries a pinned command",
    "Read that legacy case with case_get"
  ],
  "expected": "case_record refuses each with PINNED_COMMAND and a hint mentioning cwd; case_update refuses the legacy case; case_get still returns it; a relative command (including cd plugins/designmap) is accepted.",
  "tags": [
    "test-cases",
    "pinned-command"
  ],
