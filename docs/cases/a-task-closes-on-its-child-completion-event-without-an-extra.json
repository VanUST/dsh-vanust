{
  "schemaVersion": 1,
  "id": "a-task-closes-on-its-child-completion-event-without-an-extra",
  "title": "A task closes on its child completion event without an extra save",
  "requirement": "REQ-293: a legal subagent finish and the task close need no save just to refresh the verification record. AC-1: create a task, link a subagent, receive its result through the completion event and close with a result and evidence without an extra task_update; after reopening the task stays closed.",
  "kind": "scenario",
  "status": "verified",
  "source": "agent",
  "automated": true,
  "testPath": "test/write-integrity.test.mjs",
  "runCommand": "node --test --test-name-pattern=AC-1 test/write-integrity.test.mjs",
  "steps": [
    "Create a task on a fresh temporary board (chat-1, role BACKEND).",
    "Link one subagent session to the task with linkChild.",
    "Deliver the runtime's subagent/end event for that child with stopReason success.",
    "Close the task with a result summary and evidence, with no task_update in between.",
    "Start a second plugin instance on a copy of the ledger and read the row."
  ],
  "expected": "The close returns ok, the row is done with the given result and evidence, and a second plugin instance reading the same ledger still reads the row as done with that result.",
  "tags": [
    "taskboard",
    "write-integrity",
    "close",
    "child-completion",
    "REQ-293"
  ],
