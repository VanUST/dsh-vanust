{
  "schemaVersion": 1,
  "id": "dependson-is-expressible-through-the-task-tools-and-blocks-t",
  "title": "dependsOn is expressible through the task tools and blocks the start",
  "requirement": "A caller can express order on the board: task_create and task_update declare dependsOn, the update writes it to the row, and a task whose dependency is not done cannot become active (dependency_open naming the task it waits for) until that dependency is done.",
  "kind": "regression",
  "status": "unverified",
  "source": "agent",
  "automated": true,
  "testPath": "plugins/taskboard/test/dependency-open.test.mjs",
  "runCommand": "node --test plugins/taskboard/test/dependency-open.test.mjs",
  "steps": [
    "Create the dependency task and a second task with dependsOn: [that id] through task_create.",
    "Patch the second task's dependsOn through task_update and read the row back.",
    "task_update the second task to active while the dependency is open.",
    "Repeat on a board whose dependency is done."
  ],
  "expected": "Both tool schemas list dependsOn; the created and patched rows carry it; the start is refused with code dependency_open and a message naming the dependency, the row stays open; on a board whose dependency is done the same update returns ok with status active.",
  "tags": [
    "taskboard",
    "lifecycle",
    "dependsOn",
    "tool-schema"
  ],
