{
  "schemaVersion": 1,
  "id": "outline-launches-the-npm-shim-through-pathext-and-cmd-exe-an",
  "title": "Outline launches the npm shim through PATHEXT and cmd.exe, and refuses when it is absent",
  "requirement": "REQ-009: the outline tool finds the code-skeleton-mcp that npm installs as a .cmd shim on Windows and calls it with its arguments; a PATH without that shim degrades to the named refusal instead of a tool that cannot start.",
  "kind": "regression",
  "status": "verified",
  "source": "agent",
  "automated": true,
  "testPath": "plugins/outline/test/outline-shim.test.mjs",
  "runCommand": "node --test plugins/outline/test/outline-shim.test.mjs",
  "steps": [
    "Build a fixture directory holding code-skeleton-mcp.cmd that forwards its arguments to node with a stub recording argv and printing an outline.",
    "Resolve the bare name code-skeleton-mcp against that directory as the search path.",
    "Call buildOutlineResult for a path containing spaces, & and parentheses at depth 2.",
    "Resolve against a search path that holds no shim, then read the prompt section for the absent case."
  ],
  "expected": "The name resolves to <dir>\\code-skeleton-mcp.cmd, the probe accepts it, the shim receives [\"outline\", <path>, \"--depth\", \"2\"] with the path intact as one argument, and the empty search path resolves to null so the section says OUTLINE: unavailable.",
  "tags": [
    "outline",
    "windows",
    "pathext",
    "shim",
    "child_process"
  ],
