  "updatedBy": "agent",
  "title": "Клиент быстрее: измеренное открытие, интерактивность и бюджеты",
  "requestedSolution": "Владелец, 2026-11-27: «займись оптимизацией клиента — сейчас очень лагает и может долго все грузить — надо понять в чем дело и ускорить».",
  "businessOutcome": {
    "problem": "Владелец: «сейчас очень лагает и может долго все грузить». Причина не названа, и без измерения любая правка будет угадыванием: в дереве есть подозреваемые (вендоренный Excalidraw на 3.4 МБ в designmap, несколько клиентских панелей, сборка без разбиения), но ни один не подтверждён числом.",
    "outcome": "Интерфейс открывается быстро и реагирует без задержек: известны измеренные бюджеты (время до интерактивности, байты на холодном кэше, длинные задачи главного потока), и каждый следующий пакет плагинов проверяется против них.",
    "successMetrics": []
  },
  "process": {
    "current": [
      {
        "id": "P-CURRENT",
        "name": "Клиент грузится целиком и медленно",
        "actors": [
          "owner",
          "browser",
          "harness"
        ],
        "steps": [
          "Страница открывается и грузит все клиентские плагины профиля",
          "Часть из них — крупные вендоренные бандлы",
          "Главный поток занят разбором и инициализацией",
          "Взаимодействие отстаёт; никто не знает, какой пакет виноват"
        ]
      }
    ],
    "target": [
      {
        "id": "P-TARGET",
        "name": "Измерено, ранжировано, бюджеты держатся",
        "actors": [
          "owner",
          "browser",
          "harness",
          "gate"
        ],
        "steps": [
          "Холодный прогон даёт байты, время до интерактивности и длинные задачи",
          "Каждый клиентский пакет измерен отдельно (байты и блокирующее время)",
          "Топ-причины исправлены с доказательством до/после",
          "Бюджеты записаны как условие приёмки следующего пакета"
        ]
      }
    ]
  },
  "requirements": [
    {
      "id": "FR1",
      "kind": "FR",
      "text": "Загруженность клиента измерена до правки.",
      "acceptance": [
        "таблица холодного открытия"
      ],
      "status": "deferred",
      "reason": "Измерено всё, кроме браузерных панелей (измеряется сейчас)."
    },
    {
      "id": "FR2",
      "kind": "FR",
      "text": "Названная причина устранена: открытие и/или взаимодействие быстрее.",
      "acceptance": [
        "до/после на тех же прогонах"
      ],
      "status": "planned"
    },
    {
      "id": "FR3",
      "kind": "FR",
      "text": "Корневой раздел выходит из предела.",
      "acceptance": [
        "карта диска, ≥20 ГБ"
      ],
      "status": "deferred",
      "reason": "Выполнено: 34 ГБ + ≈107 МиБ."
    },
    {
      "id": "FR4",
      "kind": "FR",
      "text": "Стоимость операции не растёт с размером доски.",
      "acceptance": [
        "закрытие ≤150 мс, append ≤5 мс"
      ],
      "status": "deferred",
      "reason": "Частично: 768 → 453 мс, пол — доска 12.7 МБ."
    },
    {
      "id": "FR5",
      "kind": "FR",
      "text": "Долгие проекты масштабируются: доска = журнал + снимок.",
      "acceptance": [
        "текстовый сливаемый источник истины",
        "запись без перезаписи доски",
        "эквивалентность побайтно",
        "миграция без потерь",
        "тесты зелёные",
        "закрытие ≤50 мс"
      ],
      "status": "planned"
    },
    {
      "id": "FR6",
      "kind": "FR",
      "text": "Агент сводит работу с задачами в один вызов: создание, обновление, заметка, закрытие и отмена — одним инструментом за один шаг.",
      "acceptance": [
        "один вызов выполняет набор операций в заданном порядке: создать, обновить, заметка, закрыть, отменить",
        "набор применяется однократным чтением и однократной записью доски, а не по записи на операцию",
        "результат — компактный отчёт по каждой операции с её исходом, без дампа всей задачи",
        "действующие гейты не обходятся: базис, зависимость, причина отказа, доказательство при закрытии проверяются так же",
        "частичный отказ виден: неудавшаяся операция названа с причиной; остальные либо применены, либо откачены — явно",
        "существующие инструменты работают как раньше",
        "число шагов на типовой батч падает: закрытие пяти задач с заметками — один вызов вместо десяти, подтверждено прогоном"
      ],
      "status": "planned"
    }
  ],
