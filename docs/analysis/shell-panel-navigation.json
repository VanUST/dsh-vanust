  "decisions": [
    {
      "id": "D1",
      "decision": "Back to chat = ctx.layout.selectPanel(null), как в project-rules (pr-back)",
      "rationale": "Шов оболочки уже есть; второй механизм не нужен",
      "alternatives": [
        "своя навигация"
      ]
    },
    {
      "id": "D2",
      "decision": "Скрытие левого = layout.toggleSidebar(), правого = layout.closeRightbar()",
      "rationale": "Геометрией владеет оболочка",
      "alternatives": [
        "свои CSS-переключатели"
      ]
    },
    {
      "id": "D3",
      "decision": "Дубль Tasks убирается удалением регистрации в sidebar.panellist; вход остаётся в шапке",
      "rationale": "Один вход в одну панель",
      "alternatives": [
        "скрыть дубль через CSS"
      ]
    },
    {
      "id": "D4",
      "decision": "Верхний вход остаётся рядом с действиями сессии",
      "rationale": "Владелец видит Tasks в шапке и не просил его убирать",
      "alternatives": [
        "оставить левый вход"
      ]
    }
  ],
