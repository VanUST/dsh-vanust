# dsh-kit — local artifacts
# No trailing slash: a POSIX link is a symlink, which git classifies as a file
# rather than a directory, so `node_modules/` would leave it untracked-but-visible
# and dirty the tree after the documented dev-link setup step.
node_modules
*.log
.DS_Store
profiles-web.bak/

# Development-only package links. `probes/api-probe/node_modules` points at the
# harness packages a development checkout does not otherwise have on its resolution
# path — the installed plugin resolves them through the profile it is installed into.
# Windows creates these as junctions and POSIX as symlinks, hence the slash-free
# pattern above: only a slash-free pattern matches both.
probes/api-probe/node_modules

# Machine-local scratch state for the API probes.
probes/**/scratch/

# Per-run evidence, not source. The probe reports change on every run, so committing
# them would put a diff on every check and drown the changes that matter.
reports/

# Project specs are TRACKED on purpose: a spec file is the text every agent receives
# in its system prompt, so a change to one is a change to what the agents are told.
# It belongs in the history.
