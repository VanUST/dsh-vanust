{
  "name": "@cc/dsh-designmap",
  "version": "1.0.5",
  "description": "designmap: one Excalidraw page per design map under designmap/pages/, edited through the Project state -> Map editor (always editable, full screen) and through five agent tools (map_list, map_read, map_lint, map_edit, map_render); map_edit draws a whole scheme with the diagram op, map_lint names every readability defect with a repair, and a headless Excalidraw run renders a clean page to PNG/SVG. The host half ships pre-bundled so installing the tarball needs no registry: the kit boot must never depend on one.",
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "client.frame.js",
    "client.js",
    "dist"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node build-client.mjs",
    "build:client": "node build-client.mjs --client-only",
    "build:host": "node build-client.mjs --host-only"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@xyflow/react": "12.12.1",
    "elkjs": "0.12.1",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
