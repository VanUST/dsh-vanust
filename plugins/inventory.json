{
  "manifestVersion": 1,
  "description": "The plugins this kit ships beyond upstream, one row each. This is the single source of truth for the count and for each plugin's provenance; README.md, AGENTS.md and COMPAT.md describe the kit from it, and scripts/check-portability.mjs fails when a row, a tarball, a mounted profile row or a packing entry point disagrees with what is on disk.",
  "plugins": [
    {
      "id": "model-gate",
      "package": "@deepseek-ai/dsh-model-gate",
      "tarballPrefix": "model-gate",
      "provenance": "snapshot",
      "source": "plugins/model-gate",
      "notice": "plugins/model-gate/SOURCE-NOTICE.md",
      "pack": "scripts/rebuild-plugins.sh",
      "mounted": true
    },
    {
      "id": "dsh-context",
      "package": "@cc/dsh-context",
      "tarballPrefix": "cc-dsh-context",
      "provenance": "reconstruction",
      "source": "plugins/dsh-context",
      "notice": "plugins/dsh-context/SOURCE-NOTICE.md",
      "pack": "scripts/pack-plugin.mjs",
      "mounted": true
    },
    {
      "id": "kit-rules",
      "package": "@cc/dsh-kit-rules",
      "tarballPrefix": "cc-dsh-kit-rules",
      "provenance": "in-repo",
      "source": "plugins/kit-rules",
      "pack": "scripts/pack-plugin.mjs",
      "mounted": true
    },
    {
      "id": "ratchet",
      "package": "@cc/dsh-ratchet",
      "tarballPrefix": "cc-dsh-ratchet",
      "provenance": "in-repo",
      "source": "plugins/ratchet",
      "pack": "scripts/pack-plugin.mjs",
      "mounted": true
    }
  ]
}
